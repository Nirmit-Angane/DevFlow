# Groq API Key (Required)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override the model used for architecture & SOP generation.
# If omitted, DevFlow dynamically auto-detects and uses the best available active model (e.g. openai/gpt-oss-120b, qwen/qwen3.8-27b)
GROQ_MODEL=
